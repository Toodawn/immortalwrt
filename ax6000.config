# =====================================
# Redmi AX6000 U-BootMod
# ImmortalWrt 25.12
# =====================================


CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_redmi-router-ax6000-ubootmod=y



# =====================================
# LuCI
# =====================================

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

CONFIG_PACKAGE_luci-theme-argon=y



# =====================================
# LuCI Apps
# =====================================


CONFIG_PACKAGE_luci-app-bandix=y


CONFIG_PACKAGE_luci-app-airplay2=y


CONFIG_PACKAGE_luci-app-lucky=y


CONFIG_PACKAGE_luci-app-netdata=y

CONFIG_PACKAGE_netdata=y


CONFIG_PACKAGE_luci-app-oaf=y


CONFIG_PACKAGE_luci-app-sqm-autorate=y


CONFIG_PACKAGE_luci-app-timedreboot=y


CONFIG_PACKAGE_luci-app-ttyd=y


CONFIG_PACKAGE_luci-app-turboacc=y



# =====================================
# Proxy
# =====================================


CONFIG_PACKAGE_luci-app-openclash=y


CONFIG_PACKAGE_luci-app-daed=y



# =====================================
# ZeroTier
# =====================================

CONFIG_PACKAGE_zerotier=y

CONFIG_PACKAGE_luci-app-zerotier=y



# =====================================
# ZRAM
# =====================================

CONFIG_PACKAGE_zram-swap=y

CONFIG_PACKAGE_luci-app-zram-swap=y



# =====================================
# CPU优化
# =====================================

CONFIG_PACKAGE_irqbalance=y



# =====================================
# MTD
# =====================================

CONFIG_PACKAGE_kmod-mtd-rw=y



# =====================================
# 常用工具
# =====================================

CONFIG_PACKAGE_htop=y

CONFIG_PACKAGE_nano=y

CONFIG_PACKAGE_curl=y

CONFIG_PACKAGE_wget-ssl=y

CONFIG_PACKAGE_ca-certificates=y

CONFIG_PACKAGE_bash=y

CONFIG_PACKAGE_unzip=y

CONFIG_PACKAGE_tar=y



# =====================================
# 网络依赖
# =====================================

CONFIG_PACKAGE_dnsmasq-full=y

CONFIG_PACKAGE_ipset=y

CONFIG_PACKAGE_iptables-nft=y



# =====================================
# USB存储
# =====================================

CONFIG_PACKAGE_block-mount=y

CONFIG_PACKAGE_kmod-usb-storage=y

CONFIG_PACKAGE_kmod-fs-ext4=y
